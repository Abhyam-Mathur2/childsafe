# Environment Configuration
# Copy to .env and update with your values

# Database
# Use SQLite for development (default)
DATABASE_URL=sqlite:///./envhealth.db
# Or PostgreSQL for production
# DATABASE_URL=postgresql://user:password@localhost:5432/envhealth

# API Keys (for real integrations)
AIR_QUALITY_API_KEY=your_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Airpay Settings
AIRPAY_MERCHANT_ID=your_airpay_merchant_id
AIRPAY_USERNAME=your_airpay_username
AIRPAY_PASSWORD=your_airpay_password
AIRPAY_API_KEY=your_airpay_api_key
AIRPAY_CLIENT_ID=your_airpay_client_id
AIRPAY_SECRET_KEY=your_airpay_secret_key
AIRPAY_IS_TEST=True

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth / JWT sessions
# Client ID from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
JWT_SECRET=change-this-to-a-random-secret-key-in-production
JWT_EXPIRE_DAYS=30

# Email (Brevo) - for emailing generated health reports to users
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=ChildSafeEnviro <noreply@yourdomain.com>

# Application
DEBUG=True
APP_NAME=Environmental Health Analysis Platform
FRONTEND_URL=http://localhost:5173

DEBUG=True
APP_NAME=Environmental Health Analysis Platform
